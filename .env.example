# Copy to .env for local development. .env is gitignored.

# Neon connection string, ends in ?sslmode=require.
# Use the DEV branch here. Production runs its own branch, so a migration applied locally cannot
# break the deployed app, which is still running the old code.
POSTGRES_URL=postgresql://***

# The production (main) branch, kept under a name NOTHING reads automatically.
# Migrating or seeding production should always be a deliberate act, never something that happens
# because a shell still had the wrong value in it. Run one command against production like this:
#
#   $env:POSTGRES_URL=$env:PROD_POSTGRES_URL; pnpm db:migrate; Remove-Item Env:\POSTGRES_URL
#
# Note that `pnpm db:seed` regenerates the sample site's ~5,000 events every run, so pointing it
# at the wrong branch is not harmless.
PROD_POSTGRES_URL=

# Signing key for the session JWT. Use a different value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=***

# Deployed origin. Feeds metadataBase and the install snippet.
BASE_URL=http://localhost:3000

# Optional. Without it the app runs and stored AI reports still render; only generating new ones
# is unavailable.
DEEPSEEK_API_KEY=
